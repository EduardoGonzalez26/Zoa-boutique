# Zoa Boutique - variables de entorno (Railway)
# Copia este archivo a .env.local y llena los valores.
# NUNCA subas .env.local ni valores reales al repositorio.

# --- Google Sheets / Apps Script (inventario compartido con Carmeli) ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Oficial
GOOGLE_SHEET_VENTAS=Ventas
APPS_SCRIPT_URL=
# URL CSV publicada de la pestaña Oficial (Archivo > Compartir > Publicar en la web).
# Si se define, el archivo maestro puede seguir privado.
GOOGLE_SHEET_PUBLIC_CSV_URL=
# URL CSV publicada de la pestaña BestSellers (solo Producto/Nombre y Unidades/Cantidad, sin PII).
GOOGLE_SHEET_PUBLIC_BESTSELLERS_CSV_URL=

# --- MercadoPago ---
MERCADOPAGO_ACCESS_TOKEN=
# Ambos nombres deben contener la MISMA Public Key valida (APP_USR-... o TEST-...).
NEXT_PUBLIC_MP_PUBLIC_KEY=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Secreto configurado en el panel de MercadoPago para el webhook.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Secretos internos (header x-internal-secret) ---
# Protege /api/vendido, /api/debug-sheet y /api/debug-skydropx.
INTERNAL_API_SECRET=
# Protege /api/webhooks/payment-success.
INTERNAL_WEBHOOK_SECRET=

# --- Admin (Basic Auth para /admin) ---
# Define ambos valores. Si falta alguno, /admin responde 503.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Resend ---
RESEND_API_KEY=
# Remitente verificado, por ejemplo: Zoa <hola@zoa.mx>
RESEND_FROM_EMAIL=

# --- URLs publicas ---
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SITE_URL=

# --- Skydropx ---
SKYDROPX_API_KEY=
SKYDROPX_API_SECRET=
SKYDROPX_PICKUP_NAME=
SKYDROPX_PICKUP_STREET=
SKYDROPX_PICKUP_NUMBER=
SKYDROPX_PICKUP_APARTMENT=
SKYDROPX_PICKUP_COLONIA=
SKYDROPX_PICKUP_CITY=
SKYDROPX_PICKUP_STATE=
SKYDROPX_PICKUP_ZIP=
SKYDROPX_PICKUP_PHONE=
SKYDROPX_PICKUP_TIME_FROM=08:00
SKYDROPX_PICKUP_TIME_TO=18:00
